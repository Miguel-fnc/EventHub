{
  "name": "eventhub-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc",
    "test": "node --test test/validation.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/demo-events.sql",
    "deploy:dev": "wrangler d1 migrations apply DB --remote --env dev && wrangler deploy --env dev",
    "deploy:prod": "wrangler d1 migrations apply DB --remote --env=\"\" && wrangler deploy --env=\"\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "~5.9.3",
    "wrangler": "^4.165.0"
  }
}
